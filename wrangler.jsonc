{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "compatibility_date": "2026-07-03",
  "observability": {
    "enabled": true
  },
  "assets": {
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
